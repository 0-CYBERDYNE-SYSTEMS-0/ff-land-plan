{
  "name": "ff-voxel-twin",
  "version": "1.0.0",
  "description": "FarmFriend — farm planner and simulator for gardens and small farms",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0-CYBERDYNE-SYSTEMS-0/ff-land-plan.git"
  },
  "homepage": "https://github.com/0-CYBERDYNE-SYSTEMS-0/ff-land-plan#readme",
  "bugs": {
    "url": "https://github.com/0-CYBERDYNE-SYSTEMS-0/ff-land-plan/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "VITE_FF_ENV_RECORDS=true VITE_FF_ENV_CLIMATE=true VITE_FF_ASSET_PHYSICS=true VITE_FF_TIMELINE=true VITE_FF_CAMPAIGN=true VITE_FF_TWIN=true vite",
    "build": "tsc -b && vite build",
    "build:demo": "VITE_FF_ENV_RECORDS=true VITE_FF_ENV_CLIMATE=true VITE_FF_ASSET_PHYSICS=true VITE_FF_TIMELINE=true VITE_FF_CAMPAIGN=true VITE_FF_TWIN=true tsc -b && VITE_FF_ENV_RECORDS=true VITE_FF_ENV_CLIMATE=true VITE_FF_ASSET_PHYSICS=true VITE_FF_TIMELINE=true VITE_FF_CAMPAIGN=true VITE_FF_TWIN=true vite build",
    "build:pages": "tsc -b && vite build --base=/ff-land-plan/",
    "preview": "vite preview",
    "preview:pages": "node tools/preview-pages.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check:private": "node tools/check-private-files.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toast": "^1.3.1",
    "@tanstack/react-query": "^5.104.5",
    "camera-controls": "^3.1.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "wouter": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "fake-indexeddb": "^6.2.6",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
