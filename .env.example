# Copy to `.env.local` and set VITE_API_BASE_URL to your backend's API prefix
# (e.g. http://localhost:8787/api) to swap in the REST client; leave empty for local-first.
VITE_API_BASE_URL=

# Growing-world records are opt-in until the full core loop is released.
VITE_FF_ENV_RECORDS=false

# Environment climate runs are opt-in until equipment physics and inspector work are complete.
VITE_FF_ENV_CLIMATE=false

# Placed asset physics and storage effects are opt-in.
VITE_FF_ASSET_PHYSICS=false
