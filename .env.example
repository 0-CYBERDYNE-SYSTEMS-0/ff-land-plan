# Copy to `.env.local` and set VITE_API_BASE_URL to your backend's API prefix
# (e.g. http://localhost:8787/api) to swap in the REST client; leave empty for local-first.
VITE_API_BASE_URL=
# Optional experimental advice seam (SPEC-JEV-ADVICE): set VITE_ADVICE_URL to a Jev
# endpoint (POST, see README) or VITE_ADVICE_MOCK=1 for the deterministic mock; both unset = feature invisible.
VITE_ADVICE_URL=
VITE_ADVICE_MOCK=
